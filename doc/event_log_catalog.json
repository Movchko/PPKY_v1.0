{
  "schema_version": "1.0",
  "updated": "2026-06-25",
  "source_firmware": {
    "catalog_header": "stm_PPKY/Core/Inc/event_log_catalog.h",
    "catalog_table": "stm_PPKY/Core/Src/event_log_catalog.c",
    "record_struct": "stm_PPKY/Core/Inc/event_logger.h",
    "post_api": "stm_PPKY/Core/Inc/event_log.h"
  },

  "record": {
    "size_bytes": 32,
    "empty_flash_byte": 255,
    "endianness": "little",
    "description": "Фиксированная запись лога во внешней SPI Flash. Поля time и checksum заполняются прошивкой автоматически при EventLog_Post().",
    "fields": [
      {
        "name": "time",
        "offset": 0,
        "size": 6,
        "type": "bcd_datetime",
        "access": "firmware_auto",
        "description": "Дата и время события в BCD (как в RTC STM32)",
        "subfields": [
          { "offset": 0, "name": "year",   "type": "uint8", "format": "bcd", "range": "0..99", "note": "Год 2000+YY" },
          { "offset": 1, "name": "month",  "type": "uint8", "format": "bcd", "range": "1..12" },
          { "offset": 2, "name": "day",    "type": "uint8", "format": "bcd", "range": "1..31" },
          { "offset": 3, "name": "hour",   "type": "uint8", "format": "bcd", "range": "0..23" },
          { "offset": 4, "name": "minute", "type": "uint8", "format": "bcd", "range": "0..59" },
          { "offset": 5, "name": "second", "type": "uint8", "format": "bcd", "range": "0..59" }
        ]
      },
      {
        "name": "master_wagon_num",
        "offset": 6,
        "size": 1,
        "type": "uint8",
        "access": "payload",
        "description": "Номер мастера (h_adr ППКУ) или номер вагона в составе. 0 — если не используется."
      },
      {
        "name": "reserved",
        "offset": 7,
        "size": 1,
        "type": "uint8",
        "access": "firmware_auto",
        "default": 0,
        "description": "Резерв, всегда 0 при записи через EventLog_Post()."
      },
      {
        "name": "event_code",
        "offset": 8,
        "size": 2,
        "type": "uint16",
        "access": "firmware_auto",
        "description": "Код события (см. events[].code). Little-endian."
      },
      {
        "name": "can_header",
        "offset": 10,
        "size": 4,
        "type": "can_ext_id",
        "access": "payload",
        "description": "29-битный extended CAN ID (см. can_ext_id). Little-endian uint32."
      },
      {
        "name": "can_data",
        "offset": 14,
        "size": 8,
        "type": "bytes",
        "access": "payload",
        "description": "Данные CAN-кадра (до 8 байт). Неиспользуемые байты — 0."
      },
      {
        "name": "additional",
        "offset": 22,
        "size": 8,
        "type": "bytes",
        "access": "payload",
        "description": "Параметры, специфичные для типа события. Неиспользуемые байты — 0."
      },
      {
        "name": "checksum",
        "offset": 30,
        "size": 2,
        "type": "uint16",
        "access": "firmware_auto",
        "description": "CRC-16/CCITT-подобная сумма по байтам [0..29]. Little-endian."
      }
    ]
  },

  "checksum": {
    "algorithm": "crc16_ccitt_like",
    "init": "0xFFFF",
    "polynomial": "0x1021",
    "range_offset": 0,
    "range_size": 30,
    "note": "Совпадает с EventLogTier_CalculateChecksum() в event_logger.cpp: для каждого байта crc ^= byte<<8, затем 8 бит сдвига с xor 0x1021 при старшем бите."
  },

  "can_ext_id": {
    "description": "device_lib/include/backend.h, union can_ext_id_t, 29-bit extended ID",
    "endianness": "little",
    "layout_lsb_first": [
      { "name": "zone",   "bits": 7,  "offset": 0,  "description": "Номер зоны (0..127)" },
      { "name": "l_adr",  "bits": 6,  "offset": 7,  "description": "Подадрес виртуального устройства" },
      { "name": "h_adr",  "bits": 8,  "offset": 13, "description": "Адрес на шине (МКУ/ППКУ)" },
      { "name": "d_type", "bits": 7,  "offset": 21, "description": "Тип устройства (см. device_types)" },
      { "name": "dir",    "bits": 1,  "offset": 28, "description": "0 = команда к устройству, 1 = ответ/статус от устройства" }
    ],
    "decode_example": "can_header = zone | (l_adr<<7) | (h_adr<<13) | (d_type<<21) | (dir<<28)"
  },

  "device_types": {
    "10": { "symbol": "DEVICE_PPKY_TYPE",    "name": "ППКУ" },
    "11": { "symbol": "DEVICE_IGNITER_TYPE", "name": "Спичка (вирт.)" },
    "12": { "symbol": "DEVICE_DPT_TYPE",     "name": "ДПТ (вирт.)" },
    "13": { "symbol": "DEVICE_MCU_IGN_TYPE", "name": "МКУ спички (legacy)" },
    "14": { "symbol": "DEVICE_MCU_TC_TYPE",  "name": "МКУ ТС (legacy)" },
    "15": { "symbol": "DEVICE_BUTTON_TYPE",  "name": "Кнопка (вирт.)" },
    "16": { "symbol": "DEVICE_LSWITCH_TYPE", "name": "Концевик (вирт.)" },
    "17": { "symbol": "DEVICE_RELAY_TYPE",   "name": "Реле (вирт.)" },
    "20": { "symbol": "DEVICE_MCU_K1",       "name": "МКУ K1" },
    "21": { "symbol": "DEVICE_MCU_K2",       "name": "МКУ K2" },
    "22": { "symbol": "DEVICE_MCU_K3",       "name": "МКУ K3" },
    "23": { "symbol": "DEVICE_MCU_KR",       "name": "МКУ KR" }
  },

  "log_levels": {
    "critical": {
      "id": 0,
      "symbol": "EVENT_LOG_LEVEL_CRITICAL",
      "flash_tier": "critical",
      "description": "Только важнейшие события"
    },
    "general": {
      "id": 1,
      "symbol": "EVENT_LOG_LEVEL_GENERAL",
      "flash_tier": "general",
      "description": "Прочие события и диагностика"
    }
  },

  "payload_api": {
    "struct": "EventLogPayload_t",
    "fields": [
      { "name": "master_wagon_num", "maps_to": "record.master_wagon_num" },
      { "name": "can_header",       "maps_to": "record.can_header" },
      { "name": "can_data",         "maps_to": "record.can_data", "size": 8 },
      { "name": "additional",       "maps_to": "record.additional", "size": 8 }
    ],
    "post_function": "EventLog_Post(uint16_t code, const EventLogPayload_t *payload)"
  },

  "events": [
    {
